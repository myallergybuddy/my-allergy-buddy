<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER TEMPLATE — do not use in production builds.

  1. Open https://console.firebase.google.com and select project "my-allergy-buddy"
  2. Project settings → Your apps → Add iOS app (or select existing iOS app)
     Bundle ID must match Xcode: com.myallergybuddy.app
  3. Download GoogleService-Info.plist from Firebase Console
  4. Save as: ios/Runner/GoogleService-Info.plist (same folder as this file)
  5. In Xcode, drag GoogleService-Info.plist into the Runner target and ensure
     "Copy items if needed" and Runner target membership are checked.

  Do NOT commit real API keys or client IDs. The real file is gitignored.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_IOS_API_KEY_FROM_FIREBASE_CONSOLE</string>
	<key>GCM_SENDER_ID</key>
	<string>YOUR_GCM_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.myallergybuddy.app</string>
	<key>PROJECT_ID</key>
	<string>my-allergy-buddy</string>
	<key>STORAGE_BUCKET</key>
	<string>my-allergy-buddy.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:YOUR_PROJECT_NUMBER:ios:YOUR_IOS_APP_ID</string>
</dict>
</plist>
