# Copy this file to key.properties (same directory) and fill in your values.
# key.properties is gitignored — never commit it or your keystore.
#
# 1. Generate a keystore (run from the android/ directory):
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file:
#    cp key.properties.example key.properties   (Linux/macOS)
#    copy key.properties.example key.properties (Windows)
#
# 3. Set storeFile to the path of your .jks file, relative to the android/ directory.

storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
